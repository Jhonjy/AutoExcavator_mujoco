<?xml version="1.0"?>
<!--
  挖掘机URDF描述文件
  简化运动链：仅包含4个受控关节（rotation/boom/arm/bucket）
  闭合运动链（equality constraints）由MuJoCo内部处理，URDF仅用于：
    1. ros2_control的关节定义
    2. joint_state_publisher的关节广播
    3. RViz2的TF可视化
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="excavator">

  <!-- 引入ros2_control宏定义 -->
  <xacro:include filename="$(find excavator_ros2_bridge)/description/excavator.ros2_control.xacro"/>

  <!-- ==================== 材质定义 ==================== -->
  <material name="chassis_material">
    <color rgba="0.98 0.65 0.15 1.0"/>
  </material>
  <material name="boom_material">
    <color rgba="0.98 0.65 0.15 1.0"/>
  </material>
  <material name="bucket_material">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="base_material">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ==================== 底盘(履带) ==================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="2.0 1.2 0.4"/>
      </geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <material name="base_material"/>
    </visual>
    <inertial>
      <mass value="12200"/>
      <inertia ixx="4896" ixy="-29" ixz="-46" iyy="6689" iyz="-12" izz="10884"/>
    </inertial>
  </link>

  <!-- ==================== 回转关节 ==================== -->
  <!-- 对应MuJoCo: chassis关节 (hinge, Z轴旋转) -->
  <!-- 对应执行器: Rotation (velocity, kv=700000) -->
  <joint name="rotation_joint" type="revolute">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100000" velocity="0.5"/>
  </joint>

  <link name="chassis_link">
    <visual>
      <geometry>
        <box size="1.5 1.0 0.8"/>
      </geometry>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <material name="chassis_material"/>
    </visual>
    <inertial>
      <mass value="20592"/>
      <inertia ixx="6958" ixy="-2311" ixz="-980" iyy="13393" iyz="-677" izz="17170"/>
    </inertial>
  </link>

  <!-- ==================== 动臂关节 ==================== -->
  <!-- 对应MuJoCo: chassis piston rod (slide, X轴伸缩) -->
  <!-- 对应执行器: Boom (velocity, kv=700000) -->
  <joint name="boom_joint" type="prismatic">
    <parent link="chassis_link"/>
    <child link="boom_link"/>
    <origin xyz="0.8 0 0.6" rpy="0 -0.524 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.06" upper="0.56" effort="100000" velocity="0.5"/>
  </joint>

  <link name="boom_link">
    <visual>
      <geometry>
        <box size="3.5 0.3 0.3"/>
      </geometry>
      <origin xyz="1.75 0 0" rpy="0 0 0"/>
      <material name="boom_material"/>
    </visual>
    <inertial>
      <mass value="1600"/>
      <inertia ixx="87" ixy="-0.2" ixz="-14" iyy="1768" iyz="0.02" izz="1690"/>
    </inertial>
  </link>

  <!-- ==================== 斗杆关节 ==================== -->
  <!-- 对应MuJoCo: boom piston rod (slide, X轴伸缩) -->
  <!-- 对应执行器: Arm (velocity, kv=100000) -->
  <joint name="arm_joint" type="prismatic">
    <parent link="boom_link"/>
    <child link="arm_link"/>
    <origin xyz="3.5 0 0" rpy="0 0.524 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.28" upper="1.1" effort="50000" velocity="0.5"/>
  </joint>

  <link name="arm_link">
    <visual>
      <geometry>
        <box size="2.0 0.25 0.25"/>
      </geometry>
      <origin xyz="1.0 0 0" rpy="0 0 0"/>
      <material name="boom_material"/>
    </visual>
    <inertial>
      <mass value="880"/>
      <inertia ixx="15" ixy="-0.2" ixz="23" iyy="302" iyz="0.02" izz="290"/>
    </inertial>
  </link>

  <!-- ==================== 铲斗关节 ==================== -->
  <!-- 对应MuJoCo: arm piston rod (slide, X轴伸缩) -->
  <!-- 对应执行器: Bucket (velocity, kv=100000) -->
  <joint name="bucket_joint" type="prismatic">
    <parent link="arm_link"/>
    <child link="bucket_link"/>
    <origin xyz="1.7 0 -0.5" rpy="0 -0.698 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.15" upper="0.75" effort="50000" velocity="0.5"/>
  </joint>

  <link name="bucket_link">
    <visual>
      <geometry>
        <box size="1.0 0.8 0.6"/>
      </geometry>
      <origin xyz="0.5 0 -0.3" rpy="0 0 0"/>
      <material name="bucket_material"/>
    </visual>
    <inertial>
      <mass value="450"/>
      <inertia ixx="77" ixy="-0.2" ixz="-11" iyy="65" iyz="0.02" izz="55"/>
    </inertial>
  </link>

  <!-- ==================== ros2_control硬件接口标签 ==================== -->
  <xacro:excavator_ros2_control/>

</robot>
